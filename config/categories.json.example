{
  "_comment": "Example category rules. Copy to categories.json OR (preferred) edit categories in the admin UI (/settings) which persists to data/app.db. The pipeline reads data/app.db, not this file. 'senders' matches a full email address exactly (case-insensitive); 'domains' matches the sender's domain, subdomains included (e.g. 'acme.com' also matches 'mail.acme.com'); 'title' and 'contents' are case-insensitive substring matches. Categories are checked in priority order (HIGH > NORMAL > LOW), first match wins. priority is HIGH | NORMAL | LOW. action is trash | save | read | keep.",

  "security": {
    "description": "Account security alerts (logins, 2FA, password/verification codes)",
    "action": "save",
    "priority": "HIGH",
    "keywords": {
      "senders": [
        "no-reply@accounts.google.com",
        "account-security-noreply@accountprotection.microsoft.com",
        "security-noreply@linkedin.com"
      ],
      "title": [
        "security alert",
        "new login",
        "sign-in",
        "verification code",
        "password reset",
        "2단계 인증",
        "인증번호",
        "비밀번호 재설정"
      ],
      "contents": []
    }
  },
