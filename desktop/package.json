{
  "name": "ai-mail-agent-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "ai-mail-agent 데스크톱 셸 (Electron). packages/ 의 Python 파이프라인(mail_core/mail_app)과 Flask 관리 UI(admin_ui)를 트레이 상주 앱으로 감싼다. 스케줄링·자격증명 관리를 앱 내부에서 한다.",
  "author": "user@example.com",
  "license": "UNLICENSED",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/OWNER/ai-mail-agent"
  },
  "scripts": {
    "start": "electron .",
    "icons": "node scripts/run-python.js assets/make_icons.py",
    "prepare:python": "node scripts/run-python.js scripts/prepare_python.py",
    "dist": "node scripts/run-python.js scripts/prepare_python.py && electron-builder --win portable --publish never",
    "release": "node scripts/run-python.js scripts/prepare_python.py && electron-builder --win portable --publish always"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "io.github.rlaguswls13.ai-mail-agent",
    "productName": "ai-mail-agent",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "flask.js",
      "scheduler.js",
      "vault.js",
      "config.js",
      "preload.js",
      "updater.js",
      "renderer/**/*",
      "assets/icon.png",
      "assets/icon.ico",
      "assets/tray.png"
    ],
    "extraResources": [
      {
        "from": "pybundle",
        "to": "python"
      }
    ],
    "win": {
      "target": "portable",
      "icon": "assets/icon.ico"
    },
    "portable": {
      "artifactName": "ai-mail-agent-${version}-portable.exe"
    },
    "publish": {
      "provider": "github",
      "owner": "OWNER",
      "repo": "ai-mail-agent",
      "releaseType": "release"
    }
  }
}
